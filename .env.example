# Lose It! credentials (never commit the real .env)
LOSEIT_EMAIL=you@example.com
LOSEIT_PASSWORD=your-password

# Optional: paste a liauth JWT directly instead of using email/password
# LOSEIT_TOKEN=

# Optional overrides if Lose It ships a new web build
# LOSEIT_STRONG_NAME=351AE5DC0CA36AD3BA9C7CBA7B0E07B8
# LOSEIT_HOURS_FROM_GMT=-7
