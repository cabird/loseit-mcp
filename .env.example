# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# --- Running locally over stdio (single account) ---------------------------
LOSEIT_EMAIL=you@example.com
LOSEIT_PASSWORD=your-password

# Optional: use a liauth JWT instead of email/password
# LOSEIT_TOKEN=

# Optional: your UTC offset in whole hours. Auto-detected if unset, but set it
# explicitly for a hosted deployment, where the container runs in UTC.
# LOSEIT_HOURS_FROM_GMT=-7


# --- Hosting the server (multi-account over HTTP) --------------------------
# Credentials then come from each request, so the two settings above are not
# needed — and the server should not be started with them.

# LOSEIT_MULTI_TENANT=1

# Credential URLs, for MCP clients that cannot send auth headers.
# LOSEIT_ENROLLMENT=1

# Seals and opens credential URLs. PERMANENT: rotating it invalidates every
# URL ever issued. Generate with `loseit-mcp gen-secret`.
# LOSEIT_URL_SECRET=

# Hostnames the MCP endpoint answers on. Picked up from WEBSITE_HOSTNAME on
# Azure App Service; set explicitly for a custom domain.
# LOSEIT_ALLOWED_HOSTS=my-app.azurewebsites.net


# --- Optional hardening ----------------------------------------------------
# Enrollment is open by default: it requires the account password anyway, and
# never contacts Lose It, so it cannot be used to test credentials. Set this to
# restrict enrollment to clients that send it as X-Enroll-Secret.
# LOSEIT_ENROLL_SECRET=

# Rate limits, as capacity/seconds. Requests are throttled per client address
# and, when authenticated, per credential — both must allow the request.
# LOSEIT_ENROLL_RATE=5/3600
# LOSEIT_MCP_RATE=120/60
# LOSEIT_CREDENTIAL_RATE=200/60

# Proxies in front of the app, for resolving the real client IP.
# LOSEIT_TRUSTED_PROXIES=1


# --- Rarely needed ---------------------------------------------------------
# Override if Lose It ships a new web build and the RPCs start failing.
# LOSEIT_STRONG_NAME=351AE5DC0CA36AD3BA9C7CBA7B0E07B8
# LOSEIT_POLICY_HASH=8F87EC8969F17AE77B6283D3A83F6D4C
